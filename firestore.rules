rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users - guru can read/write their own profile
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // Soal - authenticated users can create; only creator can update/delete
    match /soal/{soalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.pembuat_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.pembuat_id);
    }

    // Siswa - any authenticated user can manage
    match /siswa/{siswaId} {
      allow read, write: if isAuthenticated();
    }

    // Nilai - any authenticated user can manage
    match /nilai/{nilaiId} {
      allow read, write: if isAuthenticated();
    }

    // Jadwal - any authenticated user can manage
    match /jadwal/{jadwalId} {
      allow read, write: if isAuthenticated();
    }

    // Legacy kitab_list (kept for backward compatibility)
    match /kitab_list/{kitabId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uploader_id == request.auth.uid;
      allow update, delete: if isOwner(resource.data.uploader_id);
    }
  }
}
