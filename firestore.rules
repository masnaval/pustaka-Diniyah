rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidKitab(data) {
      return data.judul is string && data.judul.size() > 0 && data.judul.size() < 200 &&
             data.kategori is string && data.kategori.size() > 0 &&
             data.pdf_url is string && data.pdf_url.matches("^https://.*") &&
             data.uploader_id is string &&
             data.timestamp is number;
    }

    // Kitab List Rules
    match /kitab_list/{kitabId} {
      // Anyone (including guests) can read the list of kitab
      allow read: if true;
      
      // Only authenticated users (Google Login) can create
      allow create: if isAuthenticated() && 
                      isValidKitab(request.resource.data) && 
                      request.resource.data.uploader_id == request.auth.uid;
      
      // Only the owner can update or delete their own kitab
      allow update: if isOwner(resource.data.uploader_id) && 
                      isValidKitab(request.resource.data) &&
                      request.resource.data.uploader_id == resource.data.uploader_id;
                      
      allow delete: if isOwner(resource.data.uploader_id);
    }
  }
}
